# ==== Kuro AI ====
AI_PROVIDER=gemini

# Password halaman masuk web (default: 123456789)
APP_LOGIN_PASSWORD=123456789

# Google Gemini (driver "gemini")
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# 9Router (gateway AI multi-provider, kompatibel OpenAI — lokal atau online).
# Isi base URL instance 9Router kamu, mis. https://instance-9router.up.railway.app/v1
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=
NINEROUTER_MODEL=gpt-4o-mini

# MULTI-API: provider mana pun dengan endpoint kompatibel OpenAI
# (OpenRouter, DeepSeek, OpenAI, Groq, Mistral, vLLM, dsb.)
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=

# Auto voice input (endpoint kompatibel Whisper)
VOICE_BASE_URL=https://api.openai.com/v1
VOICE_API_KEY=
VOICE_MODEL=whisper-1

QUEUE_CONNECTION=database
