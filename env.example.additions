# ==== SkripsiAI ====
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Mistral
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest

# Ollama (lokal, gratis)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# Provider kustom (endpoint kompatibel OpenAI: DeepSeek, OpenRouter, vLLM, dsb.)
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=

# Auto voice input (endpoint kompatibel Whisper)
VOICE_BASE_URL=https://api.openai.com/v1
VOICE_API_KEY=
VOICE_MODEL=whisper-1

QUEUE_CONNECTION=database
