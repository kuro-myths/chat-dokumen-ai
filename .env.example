APP_NAME="Kuro AI"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# Jumlah worker php artisan serve (multi-request) — KHUSUS LINUX (Railway/WSL).
# PENTING: biarkan komentar di Windows! PHP Windows tidak mendukung forking,
# sehingga "php artisan serve" crash "Undefined array key 1" (ServeCommand)
# kalau baris ini aktif. Railway mengaktifkan worker lewat export di Procfile.
# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# Log ke stderr supaya terlihat di dashboard Railway
LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Database default: SQLite (file dibuat otomatis saat migrate).
# Catatan Railway: filesystem ephemeral — data hilang saat redeploy.
# Untuk persistensi, pasang Volume di /app/database atau ganti ke Postgres/MySQL.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

CACHE_STORE=database

# sync = review AI jalan langsung (tanpa worker).
# Ganti ke "database" + jalankan "php artisan queue:work" di service terpisah.
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ==== Kuro AI ====
AI_PROVIDER=gemini

# Mode AI dua dropdown: "gemini" (Google AI Studio) atau "manual" (Max Router).
# Bisa juga diganti dari beranda -> "Sinkron Router", tanpa ubah .env.
AI_MODE=gemini

# Password halaman masuk web (default: 123456789)
APP_LOGIN_PASSWORD=123456789

# Google Gemini (driver "gemini") — API key gratis dari
# https://aistudio.google.com/api-keys
# Format lama AIza... maupun format baru AQ.Ab8... keduanya didukung — salin penuh.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Max Router (9Router V3) — sinkron ONLINE + OFFLINE.
# online_url dicek dulu; kalau tidak terjangkau otomatis pakai local_url,
# jadi integrasi AI tetap jalan saat offline / jalan lokal.
MAXROUTER_ONLINE_URL=
MAXROUTER_BASE_URL=http://localhost:3001/v1
MAXROUTER_API_KEY=
MAXROUTER_MODEL=gpt-4o-mini

# 9Router (gateway AI multi-provider, kompatibel OpenAI — lokal atau online)
NINEROUTER_BASE_URL=
NINEROUTER_API_KEY=
NINEROUTER_MODEL=gpt-4o-mini

# MULTI-API: provider mana pun dengan endpoint kompatibel OpenAI
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=
CUSTOM_AI_MODEL=

# Auto voice input (endpoint kompatibel Whisper)
VOICE_BASE_URL=https://api.openai.com/v1
VOICE_API_KEY=
VOICE_MODEL=whisper-1
